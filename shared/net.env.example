# Desk-buddy shared network config — TEMPLATE (no secrets).
# Copy to net.env and fill in the real values. net.env is gitignored.

WIFI_SSID=<your-ssid>
WIFI_PSWD=<your-password>
LAN_HOST=<llama-server-ip>   # e.g. 192.168.4.75 (m.tower1); router DNS can't
                             # resolve the hostname from the devices
LAN_PORT=11444
# Second inference server (srv2): e.g. 192.168.4.218 (m.mini1)
LAN2_HOST=<second-llama-server-ip>
LAN2_PORT=11444

# Weather API (Open-Meteo, no key) — host + location for the panel
WEATHER_HOST=api.open-meteo.com
WEATHER_LAT=48.1476
WEATHER_LON=17.1067
